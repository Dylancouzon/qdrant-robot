diff --git a/robot/test_brain.py b/robot/test_brain.py
new file mode 100644
index 0000000..76eafbb
--- /dev/null
+++ b/robot/test_brain.py
@@ -0,0 +1,69 @@
+"""Reply length and decode resume retain the same total token budget."""
+import contextlib
+import json
+
+import pytest
+
+from robot.brain import Brain, MAX_TOKENS
+
+FIRST = "Here is a useful first reply."
+SECOND = "Here is another useful detail for you."
+THIRD = "This last sentence must never be spoken."
+
+
+def streamed(parts):
+    return [b"data: " + json.dumps({"choices": [{"delta": {"content": part}}]}).encode()
+            for part in parts]
+
+
+def test_reply_stops_after_two_complete_statements():
+    brain = Brain.__new__(Brain)
+    requests = []
+
+    @contextlib.contextmanager
+    def post(body):
+        requests.append(body)
+        yield streamed([FIRST, " ", SECOND, " ", THIRD])
+
+    brain._post = post
+    assert "".join(brain.answer([])) == FIRST + " " + SECOND
+    assert requests[0]["max_tokens"] == MAX_TOKENS
+
+
+def test_resume_finishes_the_second_statement_with_the_remaining_budget():
+    brain = Brain.__new__(Brain)
+    requests = []
+    brain.tokens = lambda text: len(text.split())
+
+    @contextlib.contextmanager
+    def post(body):
+        requests.append(body)
+        yield streamed([FIRST, " ", SECOND, " ", THIRD])
+
+    brain._post = post
+    assert "".join(brain.answer([], prior=FIRST)) == " " + SECOND
+    assert requests[0]["max_tokens"] == MAX_TOKENS - len(FIRST.split())
+    assert requests[0]["messages"][-1] == {"role": "assistant", "content": FIRST}
+    requests.clear()
+    assert list(brain.answer([], prior=FIRST + " " + SECOND)) == []
+    assert not requests, "a completed reply must not start another decode"
+
+
+def test_resume_never_exceeds_its_total_token_budget():
+    brain = Brain.__new__(Brain)
+    brain.tokens = lambda text: MAX_TOKENS
+    brain._post = lambda body: pytest.fail("decode started with no token budget remaining")
+    assert list(brain.answer([], prior=FIRST)) == []
+
+
+def test_captions_keep_their_one_statement_limit():
+    brain = Brain.__new__(Brain)
+    requests = []
+
+    def answer(msgs, **limits):
+        requests.append(limits)
+        yield "Main object: a cup."
+
+    brain.answer = answer
+    assert brain.caption({}, lambda: False) == "Main object: a cup."
+    assert requests == [{"max_tokens": 48, "max_sentences": 1}]
