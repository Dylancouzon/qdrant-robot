+
+
+@pytest.mark.parametrize("kind,verbatim", [
+    ("social", False), ("knowledge", False), ("sight", False), ("sight", True),
+])
+def test_scene_change_keeps_nonvisual_dialogue_and_removal_persists(robot, kind, verbatim):
+    robot.route = lambda question: kind
+    robot.knowledge.search = lambda question: [(1.0, "This is a stored fact.")] if verbatim else []
+    replies = []
+
+    def answer(msgs, **_):
+        reply = f"This is response number {len(replies) + 1}."
+        replies.append(reply)
+        yield reply
+
+    robot.brain.answer = answer
+    hold_up(robot, "cup", 200, LEFT)
+    now = time.time()
+    first = Turn(question="Tell me something.", speech_start=now, line=now, speech_end=now)
+    robot._turn(first, (robot.view[0], now))
+    visual = kind == "sight" and not verbatim
+    assert first.view_dependent is visual
+    hold_up(robot, "book", 100, RIGHT, at=200)
+    for k in (1, 2):
+        at = now + 5 * k
+        turn = Turn(question="Tell me more.", speech_start=at, line=at, speech_end=at)
+        robot._turn(turn, (robot.view[0], at))
+        prior = [m for m in robot.ready.history if m["role"] == "assistant"]
+        assert any(m["content"] == first.answer for m in prior) is not visual
+        assert len(prior) == (k if not visual else k - 1)
+    assert len(robot.history) <= 2 * main.HISTORY_TURNS
+
+
+@pytest.mark.parametrize("path,visual", [
+    ("_identity", True), ("_things", True), ("_same_answer", True),
+    ("_look_back", False), ("shown", False), ("_sighted", True),
+])
+def test_code_answer_tags_its_executed_source(robot, monkeypatch, path, visual):
+    for name in ("_deletion_answer", "_confirmation_answer", "_identity", "_things",
+                 "_same_answer", "_look_back", "_sighted"):
+        monkeypatch.setattr(robot, name, lambda *args: None)
+    monkeypatch.setattr(main, "earlier_view",
+                        lambda *args: object() if path == "_look_back" else None)
+    monkeypatch.setattr(main, "shown", lambda *args: "Stored answer." if path == "shown" else None)
+    if path != "shown":
+        monkeypatch.setattr(robot, path, lambda *args: "Code answer.")
+    turn = Turn(question="A question.", visitor=robot.conversation_visitor)
+    assert robot._code_answer(turn, None, None, None, [], [], None)
+    assert turn.view_dependent is visual
+
+
+def test_model_messages_exclude_history_annotations():
+    history = [{"role": "user", "content": "Hello."},
+               {"role": "assistant", "content": "Hi!", "view_dependent": False}]
+    messages = main.brain.messages(history, None, question="How are you?")
+    assert messages[1:3] == [{"role": "user", "content": "Hello."},
+                            {"role": "assistant", "content": "Hi!"}]
+    assert history[1]["view_dependent"] is False, "the source metadata stays in robot history"
