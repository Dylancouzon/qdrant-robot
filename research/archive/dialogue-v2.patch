+    def exchanges(self, visitor: str, since: int, before: float, n: int = 10) -> list[dict]:
+        """Recent complete dialogue for this visitor, after the conversation's point-ID boundary."""
+        if not visitor:
+            return []
+        hits = self.shard.query(QueryRequest(
+            limit=n, query=OrderBy("ts", Direction.Desc), with_payload=True,
+            filter=Filter(must=[FieldCondition(key="visitor", match=MatchValue(visitor)),
+                                FieldCondition(key="ts", range=RangeFloat(lt=before)),
+                                FieldCondition(key="answer", is_empty=False)])))
+        return [self._row(h) for h in hits if h.id > since and h.payload.get("answer")]
+
+    def forget_dialogue(self, ident: str) -> None:
+        """Delete dialogue derived from an object, without adding it to visual evidence links."""
+        while rows := self.shard.scroll(ScrollRequest(limit=100, with_payload=False, filter=Filter(
+                must=[FieldCondition(key="evidence.objects", match=MatchValue(ident))])))[0]:
+            self.forget([row.id for row in rows])
