diff --git a/robot/test_dialogue.py b/robot/test_dialogue.py
new file mode 100644
index 0000000..031bebb
--- /dev/null
+++ b/robot/test_dialogue.py
@@ -0,0 +1,136 @@
+"""Quoted exchanges use existing Edge points, visitor boundaries, and deletion paths."""
+import json
+import time
+from types import SimpleNamespace as Stub
+
+import numpy as np
+import pytest
+
+from robot import brain
+from robot.main import Turn
+from robot.memory import CountRequest, Memory
+from robot.test_things import OWNER, close_robot, open_robot, thumbnail_crops
+from robot.things import DIM
+
+
+@pytest.fixture
+def robot(tmp_path, monkeypatch):
+    r = open_robot(tmp_path)
+    r.brain = Stub(tokens=lambda text: len(text.split()))
+    monkeypatch.setattr(r, "_whois", lambda *args: None)
+    yield r
+    close_robot(r)
+
+
+def recall(r, history=(), **fields):
+    turn = Turn(question="What did we discuss?", visitor=OWNER,
+                speech_start=time.time() + 1, **fields)
+    msgs = brain.messages(list(history), None, question=turn.question, past=True)
+    r._dialogue(turn, list(history), msgs, True)
+    return turn, msgs
+
+
+def test_exchange_scope_old_points_and_restart(tmp_path):
+    m = Memory(tmp_path)
+    old = m.add(None, "Old session", ts=10, visitor=OWNER, answer="Old reply")
+    current = m.add(None, "Which city?", ts=11, visitor=OWNER, answer="Tokyo")
+    m.add(None, "Other visitor", ts=12, visitor="other", answer="Private")
+    m.add(None, "Legacy statement", ts=13, visitor=OWNER)
+    m.add(None, "Future turn", ts=30, visitor=OWNER, answer="Future")
+    assert [p["id"] for p in m.exchanges(OWNER, old, 20)] == [current]
+    m.shard.close()
+    m = Memory(tmp_path)
+    assert [p["id"] for p in m.exchanges(OWNER, old, 20)] == [current]
+    assert m.exchanges(OWNER, time.time_ns() // 1000, 20) == []
+    assert m.exchanges("", 0, 20) == []
+    m.shard.close()
+
+
+def test_store_keeps_reply_on_one_existing_point_and_forget_me_removes_it(robot):
+    r = robot
+    turn = Turn(question="Which city is Japan's capital?", answer="Tokyo.",
+                visitor=OWNER, facts=["A supplied fact"])
+    assert r._store(turn, (np.zeros((9, 9, 3), np.uint8), time.time()), None, None)
+    assert r.memory.shard.count(CountRequest()) == 1
+    [row] = r.memory.exchanges(OWNER, 0, time.time() + 1)
+    assert row["answer"] == "Tokyo." and row["evidence"]["facts"] == turn.facts
+    assert "frame" not in row and not list(r.memory.frames.iterdir())
+    assert r._forget(None, None, None, OWNER)
+    assert r.memory.points([turn.frame_id]) == []
+
+
+@pytest.mark.parametrize("hidden", [False, True])
+def test_hidden_or_deleted_turn_stores_no_reply(robot, hidden):
+    robot.hiding = (None, time.time()) if hidden else None
+    turn = Turn(question="Private", answer="Private reply", visitor=OWNER, keep=hidden)
+    assert not robot._store(turn, (np.zeros((9, 9, 3), np.uint8), time.time()), None, None)
+    assert robot.memory.exchanges(OWNER, 0, time.time() + 1) == []
+
+
+def test_bounded_chronological_quotes_deduplicate_whole_pairs(robot):
+    r = robot
+    ids = [r.memory.add(None, f"Question {k}", ts=k + 1, visitor=OWNER,
+                        answer=f"Reply {k}") for k in range(12)]
+    history = [{"role": "user", "content": "Question 11"},
+               {"role": "assistant", "content": "Reply 11"}]
+    turn, msgs = recall(r, history)
+    assert turn.exchanges == ids[-7:-1]
+    text = msgs[-1]["content"][0]["text"]
+    assert "not observations" in text and "Question 11" not in text
+    assert text.index("Question 5") < text.index("Question 10")
+    assert r.brain.tokens(text.split("Visitor: What did we discuss?")[0]) <= 384
+    assert r.brain.tokens(json.dumps(msgs)) + brain.MAX_TOKENS + 128 <= brain.CONTEXT
+    evidence = r._evidence(turn)
+    assert len(evidence) == 6 and {p["source"] for p in evidence} == {"Generated dialogue"}
+    assert turn.memories == [], "quoted replies never become visual evidence IDs"
+
+
+def test_long_pairs_and_full_prompts_drop_whole_exchanges(robot):
+    r = robot
+    short = r.memory.add(None, "A short question", ts=1, visitor=OWNER, answer="A short reply")
+    r.memory.add(None, "Too long", ts=2, visitor=OWNER, answer="word " * 500)
+    assert recall(r)[0].exchanges == [short]
+    history = [{"role": "user", "content": "word " * brain.CONTEXT}]
+    turn, msgs = recall(r, history)
+    assert turn.exchanges == [] and len(msgs[-1]["content"]) == 1
+
+
+def test_ineligible_answer_never_reads_dialogue(robot, monkeypatch):
+    monkeypatch.setattr(robot.memory, "exchanges", lambda *args: pytest.fail("Unexpected recall"))
+    msgs = brain.messages([], None, question="What is here?")
+    robot._dialogue(Turn(), [], msgs, False)
+    assert len(msgs[-1]["content"]) == 1
+
+
+def test_ignored_text_objects_and_missing_sources_are_not_quoted(robot):
+    r = robot
+    r.ignored = {"phone"}
+    r.memory.add(None, "What did I show?", ts=1, visitor=OWNER, answer="A phone")
+    r.memory.add(None, "Was it yours?", ts=2, visitor=OWNER, answer="Yes, that one.",
+                 evidence={"objects": ["deleted-or-hidden-object"]})
+    r.memory.add(None, "What did you say?", ts=3, visitor=OWNER, answer="A private reply",
+                 evidence={"points": [123]})
+    assert recall(r)[0].exchanges == []
+
+
+def test_object_deletion_removes_derived_quotes_without_visual_or_retention_links(robot):
+    r = robot
+    ident = r.things.name(OWNER, "camera", ["camera"], np.eye(DIM, dtype=np.float32)[:1],
+                          thumbnail_crops([1]), "Ana")
+    source = r.memory.sighting("camera", "center", time.time(), ident)
+    original = r.things.named(OWNER, "camera", [])
+    first = Turn(question="Did you see it?", answer="Yes, that one.", visitor=OWNER,
+                 memories=[source])
+    r._store(first, (np.zeros((9, 9, 3), np.uint8), time.time()), None, None)
+    second = Turn(question="What did you reply?", answer=first.answer, visitor=OWNER,
+                  exchanges=[first.frame_id])
+    r._store(second, (np.zeros((9, 9, 3), np.uint8), time.time()), None, None)
+    assert r.things.named(OWNER, "camera", [])["turns"] == original["turns"]
+    for row in r.memory.points([first.frame_id, second.frame_id]):
+        assert row["evidence"]["objects"] == [ident]
+    r.ui_turn = Turn(exchanges=[second.frame_id])
+    r.ui_turn.ui_evidence = r._evidence(r.ui_turn)
+    assert r.ui_turn.ui_evidence
+    r._forget_object(original)
+    assert r.memory.points([source, first.frame_id, second.frame_id]) == []
+    assert r.ui_turn.ui_evidence == []
