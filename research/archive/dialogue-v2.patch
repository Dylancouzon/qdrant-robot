+    def _dialogue(self, turn: Turn, history: list[dict], msgs: list[dict], eligible: bool) -> None:
+        """Add bounded, source-checked quotations for a generated past answer without an image."""
+        if not eligible:
+            return
+        rows = self.memory.exchanges(turn.visitor, self.since, turn.speech_start)
+        points = {p["id"] for p in self.memory.points([
+            pid for row in rows for pid in row.get("evidence", {}).get("points", [])])}
+        visible = self.things.visual_links(self.ignored)
+        chosen, lines = [], []
+        header = brain.EVIDENCE + "Conversation memories (quoted dialogue, not observations):\n"
+        for row in rows:
+            evidence = row.get("evidence", {})
+            if not set(evidence.get("points", [])) <= points or not set(
+                    evidence.get("objects", [])) <= visible.keys():
+                continue
+            if mentions(row["said"] + " " + row["answer"], self.ignored):
+                continue
+            pair = [{"role": "user", "content": row["said"]},
+                    {"role": "assistant", "content": row["answer"]}]
+            if any(history[i:i + 2] == pair for i in range(len(history) - 1)):
+                continue
+            line = (f"Exchange {row['id']}, {brain.age(turn.speech_start - row['ts'])}: "
+                    f"visitor said {json.dumps(row['said'])}; "
+                    f"robot replied {json.dumps(row['answer'])}.")
+            text = header + "\n".join([line, *lines]) + "\n\n"
+            if self.brain.tokens(text) > 384:
+                continue
+            content = [{"type": "text", "text": text + msgs[-1]["content"][-1]["text"]}]
+            candidate = [*msgs[:-1], {**msgs[-1], "content": content}]
+            # JSON deliberately overcounts role/field labels; reserve chat markers and output.
+            if self.brain.tokens(json.dumps(candidate)) + brain.MAX_TOKENS + 128 > brain.CONTEXT:
+                continue
+            chosen.append(row["id"])
+            lines.insert(0, line)
+            if len(chosen) == 6:
+                break
+        if chosen:
+            msgs[-1]["content"][-1]["text"] = (
+                header + "\n".join(lines) + "\n\n" + msgs[-1]["content"][-1]["text"])
+            turn.exchanges = chosen[::-1]
+
