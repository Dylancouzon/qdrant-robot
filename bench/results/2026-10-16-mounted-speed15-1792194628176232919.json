  "source": "\"\"\"Compare 15-degree/s Stop and following at the previously cleared ten-degree bounds.\"\"\"\nimport json\nimport os\nimport signal\nimport sys\nimport time\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path.cwd()))\nfrom robot import servo\nfrom robot.head import Head, interrupt\nfrom robot.config import SHARED\nfrom bench import servo_runtime\n\nrecord = {'machine': 'Jetson', 'release': os.environ['ROBOT_RELEASE'],\n          'tegrastats': os.environ['ROBOT_TEGRASTATS'], 'configured_speed_deg_s': 15,\n          'source': Path(__file__).read_text(), 'trace': [], 'status': 'incomplete'}\noutput = SHARED / 'results' / f'2026-10-16-mounted-speed15-{time.time_ns()}.json'\nconfig = json.loads((SHARED/'servo-mounted.json').read_text())\nassert config['zero'] == 2080 and config['direction'] == 1 and config['limit'] == 45\nsignal.signal(signal.SIGTERM, interrupt)\nsignal.signal(signal.SIGINT, interrupt)\nhead = None\ntry:\n    with servo.connect(config['port']) as device:\n        record['before'] = device.status()\n        before = [device.read(a) for a in range(40)]\n        assert not record['before']['torque'] and not record['before']['moving']\n    # Return within the cleared 45-degree bounds at the qualified 10-degree/s speed.\n    head = Head(servo.SerialMotor.open(SHARED/'servo-mounted.json'))\n    head.start(); head.wait(0, 5)\n    token = head.request('right'); head.move(0, token); head.wait(token, 10)\n    record['return_degrees'] = head.angle\n    head.close(); head = None\n    path = SHARED/'experiments/servo-mounted-calibration/functional-2080-10.json'\n    servo.SPEED = servo_runtime.SPEED = 15\n    head = Head(servo.SerialMotor.open(path))\n    head.start(); head.wait(0, 5)\n    record.update(servo_runtime.exercise(head, record['trace']))\n    record['status'] = 'passed'\nexcept BaseException as error:\n    record.update(status='failed', error=repr(error))\n    raise\nfinally:\n    if head:\n        record['fault_feedback_before_cleanup'] = head.motor.status.copy()\n        head.close()\n        record['head_error'] = head.error\n    with servo.connect(config['port']) as device:\n        record['after'] = device.status()\n        record['saved_registers_unchanged'] = before == [device.read(a) for a in range(40)]\n    if record['after']['torque'] or record['after']['moving'] or not record['saved_registers_unchanged']:\n        record['status'] = 'failed'\n    output.write_text(json.dumps(record, indent=2)+'\\n')\n    print(json.dumps({'result':str(output),'status':record['status']}),flush=True)\nassert record['status'] == 'passed'\n",
