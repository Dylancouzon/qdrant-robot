fill_start')\n    try:\n        return original_prefill(self, msgs)\n    finally:\n        observe('prefill', elapsed_s=time.perf_counter() - started)\n\nbrain.Brain.prefill = prefill\noriginal_report = Scheduler.report\n\ndef report(self, now):\n    started = time.perf_counter()\n    try:\n        return original_report(self, now)\n    finally:\n        observe('evaluator_report', elapsed_s=time.perf_counter() - started)\n\nScheduler.report = report\nobserve('observer_started', command=sys.argv, release=os.environ.get('ROBOT_RELEASE'))\nrunpy.run_module(sys.argv[0], run_name='__main__')\nobserve('observer_finished')\n", "/home/qdrant/qdrant-robot/releases/435518db9947", "/home/qdrant/qdrant-robot/shared/results/2026-10-09-f1g-replay-sessions-435518db9947-1791552563527628541.timing.jsonl", "eval.replay", "eval/dev/sessions.jsonl", "--audio", "audio-real"], "expected": 47, "input_hashes": {"eval/dev/sessions.jsonl": "8d277d056080681685b11a87d7e519b32c0c5e7315831fd8cca1aece93d6d013", "eval/dev/live/closet-stopsign-center.jpg": "b6e907c56d08087f0ae1ae82a75bfb25c1171f102d0e651a7a304d10bd41ac6b", "eval/dev/audio-real/recall-stop-1.wav": "03b1391b29e78ed84026063d19f5eb65af4e7f437ca6a00e6127ba8baa02780c", "eval/dev/live/closet-night.jpg": "0c53a9c2dcc09c86edcb5f167a71632a604cad47cb29458093bd1cc5266d2c4d", "eval/dev/audio-real/recall-stop-2.wav": "2a3c2351833307ba32ecc44966d1f5cbb4dfaa35be809f5b03f7fbcad82d93a7", "eval/dev/live/closet-moto-center.jpg": "6dac36c324051994f0b0fcf023e7a4b931ddc0bfeaf3875beb9e1243c497501e", "eval/dev/audio-real/recall-moto-1.wav": "c6ac185071f7c126a3ca6bf7f58b86172140b2d37e31a8293b6d1c43d4509f5e", "eval/dev/audio-real/recall-moto-2.wav": "fb8ff99e16d2ff2b09f4e375c657119510de99e1c8d1c27f763987a3117f52be", "eval/dev/live/closet-cat-center.jpg": "d4fb59e0df135442e2fb0450ec8d7ff8f76ea73cfd25d31976d9d6841d26e63f", "eval/dev/audio-real/scene-change-1.wav": "bebe037326959bfec157ecabe37fac37ed2a4135252b7e655eddd6117a86cb67", "eval/dev/audio-real/scene-c