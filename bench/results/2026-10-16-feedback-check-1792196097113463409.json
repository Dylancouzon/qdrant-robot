  "source": "\"\"\"Retain bounded read-only feedback after an isolated overtemperature report.\"\"\"\nimport json,os,sys,time\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom robot.config import SHARED\nfrom robot.servo import connect\nr={'machine':'Jetson','release':os.environ['ROBOT_RELEASE'],'tegrastats':os.environ['ROBOT_TEGRASTATS'],'source':Path(__file__).read_text(),'samples':[]}\nwith connect('/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A46085287-if00') as s:\n for _ in range(100):\n  started=time.monotonic();state=s.status()\n  r['samples'].append({'time':time.time(),'read_s':time.monotonic()-started,'status':state,'temperature_repeat':s.read(63)})\n  assert not state['torque']\n  time.sleep(.02)\n r['lock']=s.read(55)\nr['status']='read-only complete'\np=SHARED/'results'/f'2026-10-16-feedback-check-{time.time_ns()}.json';p.write_text(json.dumps(r,indent=2)+'\\n')\nprint(json.dumps({'result':str(p),'temperatures':sorted({x['status']['temperature_c'] for x in r['samples']}),'repeated_temperatures':sorted({x['temperature_repeat'] for x in r['samples']}),'positions':[min(x['status']['position'] for x in r['samples']),max(x['status']['position'] for x in r['samples'])],'moving':sorted({x['status']['moving'] for x in r['samples']})}),flush=True)\n",
